# Supabase Configuration
SUPABASE_URL=https://jjkxvbjwruobclgwhtdt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# Auth admin (cfr. supabase/migrations/00002_admin_login.sql): account in public.admin_users,
# condivisi con recupera-test-server. Segreto firma token (8h): genera con `openssl rand -hex 32`.
ADMIN_TOKEN_SECRET=
# Solo per `npm run create:admin` (crea/aggiorna un account), non per il login.
ADMIN_USER=
ADMIN_PASSWORD=
