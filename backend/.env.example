# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# Auth admin singolo (cfr. supabase/migrations/00002_admin_login.sql)
# Segreto firma token (8h). Obbligatorio in prod; in dev genera effimero + warning.
ADMIN_TOKEN_SECRET=
# Bootstrap SOLO dev senza Supabase (login fallback) + riuso per `npm run create:admin`.
# In prod con Supabase configurato vengono ignorate: vale solo l'hash in admin_users.
ADMIN_USER=
ADMIN_PASSWORD=
