# Frontend ReCUPera dashboard — copiare in .env (mai committare .env reale)
# Base API Express — default consigliato /api/v1 (usa proxy Vite → localhost:3001, cfr. vite.config.js).
# Così eviti CORS in dev. Usa URL assoluto solo se backend su altro host.
VITE_API_BASE=/api/v1

# Letture dirette Supabase (solo ANON, mai service_role nel frontend)
# Preferire sempre il backend Express; usare queste solo se serve lettura diretta.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
