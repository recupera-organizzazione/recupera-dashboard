# Frontend ReCUPera dashboard — copiare in .env (mai committare .env reale)
# Base API Express (backend/src/index.js). Default in src/lib/api.js: /api/v1 (proxy Vite o stesso origin)
VITE_API_BASE=http://localhost:3001/api/v1

# Letture dirette Supabase (solo ANON, mai service_role nel frontend)
# Preferire sempre il backend Express; usare queste solo se serve lettura diretta.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
